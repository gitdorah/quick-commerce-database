# MySQL connection. Homebrew MySQL listens on 127.0.0.1 only.
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional: connect through a Unix socket instead of TCP (e.g. /tmp/mysql.sock).
DB_SOCKET=

# Privileged account, used only by `npm run db:setup` and `npm test`
# to rebuild QuickCommerceDB from the SQL scripts in database/.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Password for 'qc_app'@'localhost', the least-privilege account the running
# application uses (created by database/05_database_security.sql). db:setup applies it.
# MySQL's password policy usually requires 8+ characters with an uppercase
# letter, a lowercase letter, a digit and a symbol.
# Wrap any value containing # or spaces in single quotes: '#' starts a comment.
DB_APP_PASSWORD=QcApp-2026_Local!

# HTTP port for the API (and for the built client in production).
PORT=4000
